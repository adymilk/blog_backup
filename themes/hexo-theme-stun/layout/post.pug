extends ./_layout.pug

block content
  -
    var brandData = (site.data && site.data.brand) || {}
    var brand = brandData.brand || {}
    var tocHtml = toc(page.content, { list_number: false, max_depth: 3 })
    var hasToc = !!(tocHtml && page.toc !== false)
    var catName = (page.categories && page.categories.length) ? page.categories.toArray()[0].name : ''
    var summary = page.description || ''
    var related = site.posts.sort('date', -1).toArray().filter(function(p) {
      if (p.path === page.path) return false
      if (page.channel && p.channel === page.channel) return true
      return false
    }).slice(0, 4)
    if (!related.length) {
      related = site.posts.sort('date', -1).toArray().filter(function(p) { return p.path !== page.path }).slice(0, 4)
    }

  div#reading-progress.reading-progress

  div.site-container.article-wrap(class=(hasToc ? '' : 'article-wrap--no-toc'))
    article.article-main
      header.article-header
        if catName
          span.eyebrow= catName
        h1.article-header__title= page.title
        if summary
          p.article-header__summary= summary
        div.article__meta.article-header__meta
          span= brand.name || config.author
          span ·
          time.mono(datetime=date_xml(page.date))= date(page.date, 'YYYY-MM-DD')
          if typeof min2read === 'function'
            span ·
            span 约 #{min2read(page.content)} 分钟阅读
          button.copy-btn(type="button" data-copy=full_url_for(page.path)) 复制本文链接

      if hasToc
        details.mobile-toc
          summary.mobile-toc__summary 文章目录
          div.mobile-toc__body!= tocHtml

      div.prose
        != page.content

      if page.tags && page.tags.length
        div.article-tags
          each tag in page.tags.toArray()
            a.filter-chip(href=url_for(tag.path)) ##{tag.name}

      //- Author Bio Signature
      div.author-sig
        img.author-sig__avatar(src=url_for('/img/avatar-pro.jpg') alt=(brand.name || '王恒'))
        div.author-sig__body
          strong 王恒 · James Wang
          p= brand.title_zh || '工业数字化与 AI 商业化实践者'
        a.btn.btn--secondary.author-sig__cta(href="mailto:adymilk@icloud.com?subject=个人品牌网站合作与交流") 交流与合作

      if page.prev || page.next
        nav.post-nav(aria-label="文章翻页")
          if page.prev
            a.post-nav__item(href=url_for(page.prev.path))
              span.post-nav__label ← 上一篇
              span.post-nav__title= page.prev.title
          else
            div
          if page.next
            a.post-nav__item.post-nav__item--next(href=url_for(page.next.path))
              span.post-nav__label 下一篇 →
              span.post-nav__title= page.next.title

      if related && related.length
        section.related-posts
          h2.related-posts__title 相关阅读
          div.related-posts__list
            each rp in related
              a.related-posts__item(href=url_for(rp.path))= rp.title

    if hasToc
      aside.toc-aside(aria-label="文章目录")
        div.toc-aside__title 目录
        != tocHtml
