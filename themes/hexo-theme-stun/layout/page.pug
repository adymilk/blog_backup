extends ./_layout.pug

block content
  section.channel-hero
    div.site-container
      if page.type === 'tags'
        span.eyebrow TAGS
        h1.channel-hero__title 标签索引
      else if page.type === 'categories'
        span.eyebrow CATEGORIES
        h1.channel-hero__title 分类索引
      else
        span.eyebrow= (page.eyebrow || 'PAGE')
        h1.channel-hero__title= page.title || '页面'

  div.site-container(style="padding:36px 24px 72px")
    if page.type === 'tags'
      div.filter-bar
        each tag in site.tags.toArray()
          a.filter-chip(href=url_for(tag.path)) #{tag.name} (#{tag.length})
    else if page.type === 'categories'
      div.filter-bar
        each cat in site.categories.toArray()
          a.filter-chip(href=url_for(cat.path)) #{cat.name} (#{cat.length})
    else
      div.prose(style="max-width:760px")
        != page.content
