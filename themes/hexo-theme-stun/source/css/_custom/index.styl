// -----------------------------------------------------------------------------
// 简历页 /resume/
//
// 设计目标：HR 20 秒扫到关键信息，面试官 3 分钟读完决策链。
// 因此上半部分信息密度高、卡片化；下半部分交给正文排版。
// -----------------------------------------------------------------------------

.resume
  // ---------- 1. 头部卡片 ----------
  .resume-head
    padding: 28px 24px
    margin-bottom: 24px
    border-radius: 6px
    background: #fff
    border-left: 4px solid $blue-light

    &__name
      margin: 0
      font-size: 1.75rem
      font-weight: $font-weight-bolder
      line-height: 1.3

    &__name-en
      margin-left: 10px
      font-size: 1rem
      font-weight: $font-weight-normal
      opacity: 0.55

    &__title
      margin: 6px 0 0
      font-size: 1.05rem
      color: $blue-light

    &__oneliner
      margin: 12px 0 0
      font-size: 0.95rem
      line-height: 1.7

  // 联系方式：横向排布，图标对齐
  .resume-contact
    display: flex
    flex-wrap: wrap
    gap: 8px 20px
    margin: 16px 0 0
    padding: 0
    list-style: none
    font-size: 0.875rem

    li
      display: flex
      align-items: center

    i
      margin-right: 6px
      opacity: 0.6

  // 求职意向摘要
  .resume-target
    display: flex
    align-items: center
    flex-wrap: wrap
    gap: 6px
    margin: 10px 0 0
    font-size: 0.875rem

    &__label
      display: inline-block
      min-width: 4.5em
      opacity: 0.55

    &__tag
      display: inline-block
      padding: 2px 10px
      margin-right: 6px
      border-radius: 12px
      background: $blue-lighter
      color: #2b7cb8

  // ---------- 2. 通用分节 ----------
  .resume-section
    margin-bottom: 28px
    padding: 24px
    border-radius: 6px
    background: #fff

    &__title
      margin: 0 0 4px
      padding-bottom: 10px
      font-size: 1.15rem
      border-bottom: 1px solid rgba(0, 0, 0, 0.06)

    &__hint
      margin: 8px 0 16px
      font-size: 0.8rem
      opacity: 0.55

  // ---------- 3. FDE 六维能力 ----------
  .resume-dims
    display: grid
    gap: 14px

  .resume-dim
    padding: 12px 14px
    border-radius: 4px
    background: rgba(0, 0, 0, 0.015)

    &__head
      display: flex
      align-items: center
      justify-content: space-between
      gap: 12px

    &__name
      font-size: 0.925rem
      font-weight: $font-weight-bold
      line-height: 1.5

    &__level
      display: flex
      align-items: center
      flex-shrink: 0
      gap: 8px

    &__level-num
      font-size: 0.75rem
      opacity: 0.6
      white-space: nowrap

    // 五格进度条
    &__level-bar
      position: relative
      display: inline-block
      width: 70px
      height: 6px
      border-radius: 3px
      background: rgba(0, 0, 0, 0.08)
      overflow: hidden

    &__level-fill
      display: block
      height: 100%
      border-radius: 3px
      background: $blue-light
      transition: width 0.3s ease

    &__evidence
      margin: 8px 0 0
      padding-left: 18px
      font-size: 0.85rem
      line-height: 1.7

      li
        margin-bottom: 2px

    &__empty
      margin: 6px 0 0
      font-size: 0.8rem
      font-style: italic
      opacity: 0.4

  // ---------- 4. 技能关键词 ----------
  .resume-keywords
    display: flex
    flex-wrap: wrap
    gap: 8px

  .resume-keyword
    display: inline-block
    padding: 3px 12px
    border-radius: 14px
    font-size: 0.8rem
    background: $body-bg-color
    border: 1px solid rgba(0, 0, 0, 0.06)

  // ---------- 5. 正文（决策链）----------
  .resume-body
    h2:first-child
      margin-top: 0

    h3
      margin-top: 24px
      font-size: 1rem

    ul, ol
      padding-left: 22px

  .resume-foot
    margin-top: 20px
    font-size: 0.8rem
    text-align: center
    opacity: 0.55

// -----------------------------------------------------------------------------
// 夜间模式适配（主题用 html.nightmode 切换）
// -----------------------------------------------------------------------------
html.nightmode
  .resume
    .resume-head,
    .resume-section
      background: rgba(255, 255, 255, 0.04)

    .resume-dim
      background: rgba(255, 255, 255, 0.03)

    .resume-dim__level-bar
      background: rgba(255, 255, 255, 0.12)

    .resume-keyword
      background: rgba(255, 255, 255, 0.06)
      border-color: rgba(255, 255, 255, 0.1)

// -----------------------------------------------------------------------------
// 打印样式
// HR 经常直接 Ctrl+P 存 PDF —— 让打印结果也能用
// -----------------------------------------------------------------------------
@media print
  .resume
    .resume-head,
    .resume-section
      padding: 0
      margin-bottom: 16px
      background: none

    .resume-head
      border-left: none
      border-bottom: 2px solid #000
      padding-bottom: 12px

    .resume-section__title
      border-bottom: 1px solid #999

  // 打印时隐藏交互元素
  #sidebar-wrap,
  .header-nav,
  .back2top,
  .resume-foot
    display: none !important
