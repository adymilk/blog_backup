// =============================================================================
// Minimalist Editorial Tech UI (Linear / Vercel inspired)
// Single-column high-contrast layout with full light/dark mode support.
// =============================================================================

:root
  --ui-bg: #fafafa
  --ui-surface: #ffffff
  --ui-surface-subtle: #f4f4f5
  --ui-border: #e4e4e7
  --ui-border-hover: #d4d4d8
  --ui-text: #18181b
  --ui-text-secondary: #52525b
  --ui-text-muted: #71717a
  --ui-accent: #2563eb
  --ui-accent-soft: rgba(37, 99, 235, 0.08)
  --ui-nav-bg: rgba(250, 250, 250, 0.84)
  --ui-shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04)
  --ui-shadow-md: 0 4px 16px rgba(0, 0, 0, 0.05)

html.nightmode
  --ui-bg: #09090b
  --ui-surface: #111114
  --ui-surface-subtle: #18181b
  --ui-border: #27272a
  --ui-border-hover: #3f3f46
  --ui-text: #f4f4f5
  --ui-text-secondary: #a1a1aa
  --ui-text-muted: #71717a
  --ui-accent: #60a5fa
  --ui-accent-soft: rgba(96, 165, 250, 0.12)
  --ui-nav-bg: rgba(9, 9, 11, 0.84)
  --ui-shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.25)
  --ui-shadow-md: 0 8px 24px rgba(0, 0, 0, 0.35)

// -----------------------------------------------------------------------------
// 1. Global Base & Typography
// -----------------------------------------------------------------------------
body
  font-family: -apple-system, BlinkMacSystemFont, "Inter", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif
  -webkit-font-smoothing: antialiased
  -moz-osx-font-smoothing: grayscale
  background-color: var(--ui-bg) !important
  color: var(--ui-text)
  line-height: 1.75

code, pre, .landing-writing__date, .landing-case__badge
  font-family: "JetBrains Mono", "SF Mono", Menlo, Monaco, Consolas, monospace

a
  color: var(--ui-accent)
  text-decoration: none

  &:hover
    color: var(--ui-accent)

// -----------------------------------------------------------------------------
// 2. Clean Minimalist Frosted Navbar (Always visible, no giant banner)
// -----------------------------------------------------------------------------
.header-inner--height,
.header-inner--bgcolor
  background-color: transparent !important

.header-nav
  position: fixed !important
  top: 0
  left: 0
  right: 0
  transform: translateY(0) !important
  background-color: var(--ui-nav-bg) !important
  backdrop-filter: blur(12px)
  -webkit-backdrop-filter: blur(12px)
  border-bottom: 1px solid var(--ui-border)

  &-inner
    max-width: 860px
    margin: 0 auto

  &-menubtn
    color: var(--ui-text) !important

  &-menu-item__link
    color: var(--ui-text-secondary) !important
    font-size: 0.88rem
    font-weight: 500
    border-radius: 6px
    padding: 0 0.7rem !important
    transition: color 0.15s ease, background-color 0.15s ease

    &:hover
      color: var(--ui-text) !important
      background-color: var(--ui-surface-subtle) !important

    i
      opacity: 0.65
      font-size: 0.82em

  &-search
    color: var(--ui-text-secondary) !important
    font-size: 0.88rem

    &:hover
      color: var(--ui-text) !important

.main
  padding-top: 2.25rem

.main-inner
  max-width: 860px !important
  margin: 0 auto

// -----------------------------------------------------------------------------
// 3. Landing Page (/index.html)
// -----------------------------------------------------------------------------
.landing
  padding: 1.25rem 0 2.5rem

.landing-hero
  padding: 2rem 0 2.75rem
  border-bottom: 1px solid var(--ui-border)

  &__title
    margin: 1rem 0 0.5rem
    font-size: 2.35rem
    font-weight: 800
    letter-spacing: -0.03em
    line-height: 1.2
    color: var(--ui-text)

  &__en
    margin-left: 0.65rem
    font-size: 1.25rem
    font-weight: 400
    color: var(--ui-text-muted)
    letter-spacing: -0.01em

  &__subtitle
    margin: 0.5rem 0 0
    font-size: 1.2rem
    font-weight: 600
    color: var(--ui-text)
    line-height: 1.45

  &__desc
    margin: 0.9rem 0 0
    max-width: 660px
    font-size: 0.96rem
    color: var(--ui-text-secondary)
    line-height: 1.75

  &__actions
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 0.75rem
    margin-top: 1.65rem

.landing-badge
  display: inline-flex
  align-items: center
  gap: 0.5rem
  padding: 0.3rem 0.75rem
  border-radius: 999px
  background-color: var(--ui-surface)
  border: 1px solid var(--ui-border)
  font-size: 0.78rem
  color: var(--ui-text-secondary)
  box-shadow: var(--ui-shadow-sm)

  &__dot
    width: 7px
    height: 7px
    border-radius: 50%
    background-color: #10b981
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.18)

.landing-btn
  display: inline-flex
  align-items: center
  gap: 0.45rem
  padding: 0.55rem 1.15rem
  border-radius: 8px
  font-size: 0.88rem
  font-weight: 500
  transition: all 0.18s ease
  cursor: pointer

  &--primary
    background-color: var(--ui-text)
    color: var(--ui-bg) !important
    border: 1px solid var(--ui-text)

    &:hover
      opacity: 0.88
      transform: translateY(-1px)

  &--secondary
    background-color: var(--ui-surface)
    color: var(--ui-text) !important
    border: 1px solid var(--ui-border)
    box-shadow: var(--ui-shadow-sm)

    &:hover
      border-color: var(--ui-border-hover)
      background-color: var(--ui-surface-subtle)

  &--ghost
    color: var(--ui-text-secondary) !important
    padding: 0.55rem 0.75rem

    &:hover
      color: var(--ui-text) !important

// Sections
.landing-section
  padding: 2.5rem 0 0

  &__head
    display: flex
    align-items: baseline
    justify-content: space-between
    margin-bottom: 1.25rem

  &__title
    margin: 0
    font-size: 1.15rem
    font-weight: 700
    letter-spacing: -0.015em
    color: var(--ui-text)

  &__more
    font-size: 0.84rem
    font-weight: 500
    color: var(--ui-text-muted) !important
    transition: color 0.15s ease

    &:hover
      color: var(--ui-text) !important


// Capability Pillars Grid
.landing-pillars
  display: grid
  grid-template-columns: repeat(3, 1fr)
  gap: 1rem

@media (max-width: 767px)
  .landing-pillars
    grid-template-columns: 1fr

.landing-pillar
  padding: 1.2rem 1.25rem
  border-radius: 10px
  background-color: var(--ui-surface)
  border: 1px solid var(--ui-border)
  box-shadow: var(--ui-shadow-sm)

  &__title
    margin: 0 0 0.45rem
    font-size: 0.96rem
    font-weight: 700
    color: var(--ui-text)

  &__desc
    margin: 0
    font-size: 0.84rem
    line-height: 1.68
    color: var(--ui-text-secondary)

// Case Study Cards
.landing-cases
  display: grid
  grid-template-columns: repeat(3, 1fr)
  gap: 1rem

@media (max-width: 767px)
  .landing-cases
    grid-template-columns: 1fr

  .landing-hero__title
    font-size: 1.85rem

.landing-case
  display: flex
  flex-direction: column
  padding: 1.25rem
  border-radius: 10px
  background-color: var(--ui-surface)
  border: 1px solid var(--ui-border)
  box-shadow: var(--ui-shadow-sm)
  transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease

  &:hover
    transform: translateY(-2px)
    border-color: var(--ui-border-hover)
    box-shadow: var(--ui-shadow-md)

  &--accent
    border-style: dashed

  &__top
    display: flex
    align-items: center
    justify-content: space-between
    gap: 0.5rem
    margin-bottom: 0.75rem

  &__domain
    font-size: 0.74rem
    color: var(--ui-text-muted)

  &__badge
    font-size: 0.7rem
    font-weight: 600
    padding: 0.15rem 0.45rem
    border-radius: 5px
    background-color: var(--ui-accent-soft)
    color: var(--ui-accent)

  &__title
    margin: 0 0 0.5rem
    font-size: 1rem
    font-weight: 700
    line-height: 1.4
    color: var(--ui-text)

  &__desc
    margin: 0 0 1rem
    font-size: 0.84rem
    line-height: 1.65
    color: var(--ui-text-secondary)
    flex: 1

  &__tags
    display: flex
    flex-wrap: wrap
    gap: 0.4rem

    span
      font-size: 0.72rem
      padding: 0.15rem 0.5rem
      border-radius: 4px
      background-color: var(--ui-surface-subtle)
      color: var(--ui-text-muted)

// Selected Writing List
.landing-writing
  list-style: none
  margin: 0
  padding: 0
  border-top: 1px solid var(--ui-border)

  &__item
    border-bottom: 1px solid var(--ui-border)

  &__link
    display: flex
    align-items: center
    gap: 1rem
    padding: 0.85rem 0.5rem
    border-radius: 6px
    transition: background-color 0.15s ease

    &:hover
      background-color: var(--ui-surface-subtle)

      .landing-writing__title
        color: var(--ui-accent)

  &__date
    flex-shrink: 0
    font-size: 0.8rem
    color: var(--ui-text-muted)

  &__title
    flex: 1
    font-size: 0.94rem
    font-weight: 500
    color: var(--ui-text)
    transition: color 0.15s ease

  &__cat
    flex-shrink: 0
    font-size: 0.74rem
    padding: 0.15rem 0.55rem
    border-radius: 999px
    background-color: var(--ui-surface-subtle)
    color: var(--ui-text-muted)

@media (max-width: 575px)
  .landing-writing__cat
    display: none

// -----------------------------------------------------------------------------
// 4. Unified Sub-pages (Post, Archives, Works, About, Resume)
// -----------------------------------------------------------------------------
.content-page,
.post,
.postlist-item
  background-color: var(--ui-surface) !important
  border: 1px solid var(--ui-border)
  border-radius: 10px !important
  box-shadow: var(--ui-shadow-sm)
  padding: 2rem 2.25rem !important

@media (max-width: 767px)
  .content-page,
  .post,
  .postlist-item
    padding: 1.35rem 1.15rem !important

.post-body,
.content-page
  h1, h2, h3
    letter-spacing: -0.015em
    font-weight: 700
    color: var(--ui-text)

  blockquote
    border-left: 3px solid var(--ui-accent)
    background-color: var(--ui-accent-soft)
    border-radius: 0 6px 6px 0
    padding: 0.75rem 1rem
    margin: 1.25rem 0

  figure.highlight
    border-radius: 8px
    overflow: hidden
    border: 1px solid var(--ui-border)

.footer
  background-color: transparent !important
  border-top: 1px solid var(--ui-border)
  color: var(--ui-text-muted) !important

// -----------------------------------------------------------------------------
// 5. Resume Page (/resume/)
// -----------------------------------------------------------------------------
.resume
  .resume-head
    padding: 1.75rem 2rem
    margin-bottom: 1.5rem
    border-radius: 10px
    background: var(--ui-surface)
    border: 1px solid var(--ui-border)
    border-left: 4px solid var(--ui-accent)
    box-shadow: var(--ui-shadow-sm)

    &__name
      margin: 0
      font-size: 1.75rem
      font-weight: 700
      letter-spacing: -0.02em
      line-height: 1.3

    &__name-en
      margin-left: 10px
      font-size: 1rem
      font-weight: 400
      color: var(--ui-text-muted)

    &__title
      margin: 6px 0 0
      font-size: 1.05rem
      font-weight: 600
      color: var(--ui-accent)

    &__oneliner
      margin: 12px 0 0
      font-size: 0.95rem
      line-height: 1.75
      color: var(--ui-text-secondary)

  .resume-contact
    display: flex
    flex-wrap: wrap
    gap: 8px 20px
    margin: 16px 0 0
    padding: 0
    list-style: none
    font-size: 0.875rem

    li
      display: flex
      align-items: center

    i
      margin-right: 6px
      color: var(--ui-text-muted)

  .resume-target
    display: flex
    align-items: center
    flex-wrap: wrap
    gap: 6px
    margin: 10px 0 0
    font-size: 0.875rem

    &__label
      display: inline-block
      min-width: 4.5em
      color: var(--ui-text-muted)

    &__tag
      display: inline-block
      padding: 2px 10px
      margin-right: 6px
      border-radius: 999px
      background: var(--ui-accent-soft)
      color: var(--ui-accent)
      font-weight: 500

  .resume-section
    margin-bottom: 1.5rem
    padding: 1.75rem 2rem
    border-radius: 10px
    background: var(--ui-surface)
    border: 1px solid var(--ui-border)
    box-shadow: var(--ui-shadow-sm)

    &__title
      margin: 0 0 4px
      padding-bottom: 10px
      font-size: 1.15rem
      font-weight: 700
      border-bottom: 1px solid var(--ui-border)

    &__hint
      margin: 8px 0 16px
      font-size: 0.8rem
      color: var(--ui-text-muted)

  .resume-dims
    display: grid
    gap: 12px

  .resume-dim
    padding: 14px 16px
    border-radius: 8px
    background: var(--ui-bg)
    border: 1px solid var(--ui-border)

    &__head
      display: flex
      align-items: center
      justify-content: space-between
      gap: 12px

    &__name
      font-size: 0.925rem
      font-weight: 600
      line-height: 1.5

    &__level
      display: flex
      align-items: center
      flex-shrink: 0
      gap: 8px

    &__level-num
      font-size: 0.75rem
      color: var(--ui-text-muted)
      white-space: nowrap

    &__level-bar
      position: relative
      display: inline-block
      width: 72px
      height: 6px
      border-radius: 999px
      background: rgba(113, 113, 122, 0.2)
      overflow: hidden

    &__level-fill
      display: block
      height: 100%
      border-radius: 999px
      background: var(--ui-accent)
      transition: width 0.3s ease

    &__evidence
      margin: 8px 0 0
      padding-left: 18px
      font-size: 0.85rem
      line-height: 1.7

      li
        margin-bottom: 2px

    &__empty
      margin: 6px 0 0
      font-size: 0.8rem
      font-style: italic
      color: var(--ui-text-muted)

  .resume-keywords
    display: flex
    flex-wrap: wrap
    gap: 8px

  .resume-keyword
    display: inline-block
    padding: 4px 12px
    border-radius: 999px
    font-size: 0.8rem
    background: var(--ui-bg)
    border: 1px solid var(--ui-border)
    transition: border-color 0.18s ease

    &:hover
      border-color: var(--ui-accent)

  .resume-body
    h2:first-child
      margin-top: 0

    h3
      margin-top: 24px
      font-size: 1rem

    ul, ol
      padding-left: 22px

  .resume-foot
    margin-top: 20px
    font-size: 0.8rem
    text-align: center
    color: var(--ui-text-muted)

// -----------------------------------------------------------------------------
// 6. Print Styles
// -----------------------------------------------------------------------------
@media print
  .resume
    .resume-head,
    .resume-section
      padding: 0
      margin-bottom: 16px
      background: none
      border: none
      box-shadow: none

    .resume-head
      border-bottom: 2px solid #000
      padding-bottom: 12px

    .resume-section__title
      border-bottom: 1px solid #999

  #sidebar-wrap,
  .header-nav,
  .back2top,
  .resume-foot
    display: none !important


// Executive Portrait Framing (Homepage Hero & Resume Header)
.landing-hero__top
  display: flex
  align-items: center
  justify-content: space-between
  gap: 1.75rem

.landing-hero__intro
  flex: 1
  min-width: 0

.landing-hero__avatar-wrap
  flex-shrink: 0

.landing-hero__avatar
  display: block
  width: 108px
  height: 108px
  border-radius: 18px
  object-fit: cover
  object-position: 58% 28%
  border: 1px solid var(--ui-border)
  box-shadow: var(--ui-shadow-md)

.resume-head__top
  display: flex
  align-items: flex-start
  justify-content: space-between
  gap: 1.5rem

.resume-head__info
  flex: 1
  min-width: 0

.resume-head__avatar-wrap
  flex-shrink: 0

.resume-head__avatar
  display: block
  width: 88px
  height: 88px
  border-radius: 14px
  object-fit: cover
  object-position: 58% 28%
  border: 1px solid var(--ui-border)
  box-shadow: var(--ui-shadow-sm)

@media (max-width: 640px)
  .landing-hero__top,
  .resume-head__top
    flex-direction: column-reverse
    align-items: flex-start
    gap: 1rem

  .landing-hero__avatar
    width: 84px
    height: 84px

  .resume-head__avatar
    width: 72px
    height: 72px
