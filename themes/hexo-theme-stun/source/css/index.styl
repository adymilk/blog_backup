// =============================================================================
// Premium Editorial + Modern Technology Design System
// Palette: White / Off-White / Deep Charcoal / Low-Saturation Steel Blue
// =============================================================================

:root
  --bg: #fafafa
  --surface: #ffffff
  --surface-alt: #f3f4f6
  --border: #e5e7eb
  --border-strong: #d1d5db
  --text: #111827
  --text-secondary: #4b5563
  --text-muted: #6b7280
  --accent: #2b5b84
  --accent-hover: #1e4363
  --accent-soft: rgba(43, 91, 132, 0.08)
  --nav-bg: rgba(250, 250, 250, 0.88)
  --shadow-sm: 0 1px 2px rgba(17, 24, 39, 0.04)
  --shadow-md: 0 8px 28px rgba(17, 24, 39, 0.06)
  --radius-sm: 6px
  --radius-md: 10px
  --radius-lg: 14px

html.nightmode
  --bg: #0b0d11
  --surface: #12151c
  --surface-alt: #1a1e28
  --border: #232834
  --border-strong: #323949
  --text: #f3f4f6
  --text-secondary: #9ca3af
  --text-muted: #6b7280
  --accent: #6897c8
  --accent-hover: #8ab2db
  --accent-soft: rgba(104, 151, 200, 0.14)
  --nav-bg: rgba(11, 13, 17, 0.86)
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3)
  --shadow-md: 0 12px 32px rgba(0, 0, 0, 0.45)

*, *::before, *::after
  box-sizing: border-box

html
  font-size: 16px
  scroll-behavior: smooth

body
  margin: 0
  padding-top: 64px
  background-color: var(--bg)
  color: var(--text)
  font-family: -apple-system, BlinkMacSystemFont, "Inter", "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif
  font-size: 0.96875rem
  line-height: 1.75
  -webkit-font-smoothing: antialiased
  text-rendering: optimizeLegibility

a
  color: inherit
  text-decoration: none

img, video
  max-width: 100%
  height: auto

code, pre, .mono
  font-family: "JetBrains Mono", "SF Mono", Menlo, Monaco, Consolas, monospace
  font-variant-numeric: tabular-nums

.site-container
  width: 100%
  max-width: 1080px
  margin: 0 auto
  padding: 0 24px

.prose-container
  width: 100%
  max-width: 720px
  margin: 0 auto

// -----------------------------------------------------------------------------
// Fixed Editorial Header & Mobile Drawer
// -----------------------------------------------------------------------------
.site-header
  position: fixed
  top: 0
  left: 0
  right: 0
  z-index: 40
  height: 64px
  background-color: var(--nav-bg)
  backdrop-filter: blur(12px)
  -webkit-backdrop-filter: blur(12px)
  border-bottom: 1px solid transparent
  transition: border-color 0.2s ease, box-shadow 0.2s ease

  &.is-scrolled
    border-bottom-color: var(--border)
    box-shadow: var(--shadow-sm)

  &__inner
    height: 100%
    display: flex
    align-items: center
    justify-content: space-between
    gap: 16px

.site-brand
  display: inline-flex
  align-items: center
  gap: 10px
  flex-shrink: 0

  &__name
    font-size: 1rem
    font-weight: 700
    letter-spacing: -0.02em
    color: var(--text)

  &__tag
    font-size: 0.72rem
    padding: 2px 8px
    border-radius: 999px
    background-color: var(--accent-soft)
    color: var(--accent)
    font-weight: 500

.site-nav
  display: flex
  align-items: center
  gap: 20px

  &__link
    font-size: 0.84rem
    font-weight: 500
    color: var(--text-muted)
    transition: color 0.16s ease
    white-space: nowrap

    &:hover,
    &.is-active
      color: var(--text)

    &.is-active
      position: relative

      &::after
        content: ""
        position: absolute
        left: 0
        right: 0
        bottom: -6px
        height: 1.5px
        background-color: var(--accent)

.site-controls
  display: flex
  align-items: center
  gap: 8px
  flex-shrink: 0

.icon-btn,
.lang-btn
  display: inline-flex
  align-items: center
  justify-content: center
  height: 32px
  padding: 0 8px
  border-radius: var(--radius-sm)
  border: 1px solid transparent
  background: transparent
  color: var(--text-secondary)
  font-size: 0.78rem
  font-weight: 600
  cursor: pointer
  transition: background-color 0.16s ease, color 0.16s ease, border-color 0.16s ease

  &:hover
    background-color: var(--surface-alt)
    color: var(--text)

.theme-sun
  display: none

html.nightmode
  .theme-sun
    display: block
  .theme-moon
    display: none

.contact-cta
  display: inline-flex
  align-items: center
  height: 32px
  padding: 0 12px
  border-radius: var(--radius-sm)
  background-color: var(--accent)
  color: #ffffff !important
  font-size: 0.8rem
  font-weight: 500
  transition: background-color 0.16s ease

  &:hover
    background-color: var(--accent-hover)

.menu-btn
  display: none
  align-items: center
  justify-content: center
  width: 34px
  height: 34px
  border: none
  background: transparent
  color: var(--text)
  cursor: pointer

@media (max-width: 960px)
  .site-nav,
  .contact-cta
    display: none
  .menu-btn
    display: inline-flex

@media (max-width: 480px)
  .site-brand__tag
    display: none

// Mobile Drawer
.mobile-drawer
  position: fixed
  inset: 0
  z-index: 60
  pointer-events: none
  opacity: 0
  transition: opacity 0.22s ease

  &.is-open
    pointer-events: auto
    opacity: 1

    .mobile-drawer__panel
      transform: translateX(0)

  &__backdrop
    position: absolute
    inset: 0
    background: rgba(0, 0, 0, 0.45)

  &__panel
    position: absolute
    top: 0
    right: 0
    bottom: 0
    width: min(300px, 84vw)
    background: var(--surface)
    border-left: 1px solid var(--border)
    padding: 20px 24px
    transform: translateX(100%)
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1)

  &__head
    display: flex
    align-items: center
    justify-content: space-between
    padding-bottom: 16px
    border-bottom: 1px solid var(--border)

  &__nav
    display: flex
    flex-direction: column
    gap: 4px
    margin-top: 16px

    a
      padding: 10px 8px
      border-radius: var(--radius-sm)
      font-size: 0.94rem
      font-weight: 500
      color: var(--text-secondary)

      &:hover
        background: var(--surface-alt)
        color: var(--text)

// -----------------------------------------------------------------------------
// Buttons & Micro-labels
// -----------------------------------------------------------------------------
.btn
  display: inline-flex
  align-items: center
  gap: 8px
  padding: 10px 20px
  border-radius: var(--radius-sm)
  font-size: 0.875rem
  font-weight: 500
  transition: all 0.18s ease
  cursor: pointer

  &--primary
    background-color: var(--accent)
    color: #ffffff !important
    border: 1px solid var(--accent)

    &:hover
      background-color: var(--accent-hover)
      transform: translateY(-1px)

  &--secondary
    background-color: var(--surface)
    color: var(--text) !important
    border: 1px solid var(--border-strong)

    &:hover
      border-color: var(--text-muted)
      background-color: var(--surface-alt)

.eyebrow
  display: inline-block
  font-family: "JetBrains Mono", monospace
  font-size: 0.72rem
  font-weight: 600
  letter-spacing: 0.08em
  text-transform: uppercase
  color: var(--accent)

// -----------------------------------------------------------------------------
// Home Sections (Hero + A~G)
// -----------------------------------------------------------------------------
.section
  padding: 64px 0

  &--bordered
    border-top: 1px solid var(--border)

  &__head
    display: flex
    align-items: flex-end
    justify-content: space-between
    gap: 16px
    margin-bottom: 32px

  &__title
    margin: 6px 0 0
    font-size: 1.5rem
    font-weight: 700
    letter-spacing: -0.02em
    line-height: 1.3

  &__more
    font-size: 0.85rem
    font-weight: 500
    color: var(--accent)
    white-space: nowrap

    &:hover
      text-decoration: underline
      text-underline-offset: 4px

// Hero (Split Asymmetric Editorial)
.hero
  padding: 56px 0 64px

  &__grid
    display: grid
    grid-template-columns: 1.25fr 0.95fr
    gap: 48px
    align-items: center

  &__subtitle
    margin: 10px 0 0
    font-size: 0.95rem
    font-weight: 500
    color: var(--text-muted)

  &__title
    margin: 14px 0 0
    font-size: 2.5rem
    font-weight: 800
    letter-spacing: -0.03em
    line-height: 1.22
    color: var(--text)

  &__desc
    margin: 18px 0 0
    font-size: 1rem
    line-height: 1.75
    color: var(--text-secondary)
    max-width: 540px

  &__actions
    display: flex
    flex-wrap: wrap
    gap: 12px
    margin-top: 28px

  &__visual
    position: relative

  &__photo
    display: block
    width: 100%
    aspect-ratio: 3 / 2
    object-fit: cover
    object-position: center 20%
    border-radius: var(--radius-lg)
    border: 1px solid var(--border)
    box-shadow: var(--shadow-md)

  &__caption
    margin-top: 10px
    font-size: 0.78rem
    color: var(--text-muted)
    display: flex
    justify-content: space-between

@media (max-width: 840px)
  .hero
    padding: 32px 0 48px

    &__grid
      grid-template-columns: 1fr
      gap: 28px

    &__title
      font-size: 1.95rem

// A. Personal Profile Strip
.profile-strip
  display: grid
  grid-template-columns: 1fr 1.6fr
  gap: 36px
  padding: 28px 32px
  border-radius: var(--radius-md)
  background-color: var(--surface)
  border: 1px solid var(--border)
  box-shadow: var(--shadow-sm)

  &__role
    margin: 6px 0 0
    font-size: 1.15rem
    font-weight: 700

  &__en
    margin: 4px 0 0
    font-size: 0.84rem
    color: var(--text-muted)

  &__points
    margin: 0
    padding-left: 18px
    color: var(--text-secondary)
    font-size: 0.92rem

    li
      margin-bottom: 8px

      &:last-child
        margin-bottom: 0

@media (max-width: 768px)
  .profile-strip
    grid-template-columns: 1fr
    gap: 18px
    padding: 22px

// B. Focus Areas (3 Cards)
.focus-grid
  display: grid
  grid-template-columns: repeat(3, 1fr)
  gap: 20px

.focus-card
  display: flex
  flex-direction: column
  padding: 26px 24px
  border-radius: var(--radius-md)
  background-color: var(--surface)
  border: 1px solid var(--border)
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease

  &:hover
    transform: translateY(-3px)
    border-color: var(--accent)
    box-shadow: var(--shadow-md)

  &__en
    font-family: "JetBrains Mono", monospace
    font-size: 0.72rem
    color: var(--accent)
    margin-bottom: 8px

  &__title
    margin: 0 0 10px
    font-size: 1.05rem
    font-weight: 700

  &__desc
    margin: 0
    font-size: 0.875rem
    color: var(--text-secondary)
    line-height: 1.7

@media (max-width: 840px)
  .focus-grid
    grid-template-columns: 1fr

// C. Featured Projects (Large Visual Cards)
.project-grid
  display: grid
  grid-template-columns: repeat(3, 1fr)
  gap: 22px

.project-card
  display: flex
  flex-direction: column
  border-radius: var(--radius-md)
  background-color: var(--surface)
  border: 1px solid var(--border)
  overflow: hidden
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease

  &:hover
    transform: translateY(-3px)
    box-shadow: var(--shadow-md)
    border-color: var(--border-strong)

    .project-card__cover img
      transform: scale(1.03)

  &__cover
    aspect-ratio: 16 / 10
    overflow: hidden
    background-color: var(--surface-alt)
    border-bottom: 1px solid var(--border)

    img
      width: 100%
      height: 100%
      object-fit: cover
      object-position: center 25%
      transition: transform 0.35s ease

  &__body
    display: flex
    flex-direction: column
    flex: 1
    padding: 20px

  &__cat
    font-size: 0.74rem
    color: var(--accent)
    font-weight: 600
    margin-bottom: 6px

  &__title
    margin: 0 0 8px
    font-size: 1.02rem
    font-weight: 700
    line-height: 1.4

  &__desc
    margin: 0 0 16px
    font-size: 0.85rem
    color: var(--text-secondary)
    flex: 1

  &__tags
    display: flex
    flex-wrap: wrap
    gap: 6px

    span
      font-size: 0.72rem
      padding: 2px 8px
      border-radius: 4px
      background-color: var(--surface-alt)
      color: var(--text-muted)

@media (max-width: 840px)
  .project-grid
    grid-template-columns: 1fr

// D. Latest Insights (Magazine Layout)
.insights-grid
  display: grid
  grid-template-columns: repeat(2, 1fr)
  gap: 20px

.insight-card
  display: flex
  flex-direction: column
  padding: 24px
  border-radius: var(--radius-md)
  background-color: var(--surface)
  border: 1px solid var(--border)
  transition: border-color 0.18s ease, box-shadow 0.18s ease

  &:hover
    border-color: var(--accent)
    box-shadow: var(--shadow-sm)

  &__meta
    display: flex
    align-items: center
    gap: 10px
    font-size: 0.78rem
    color: var(--text-muted)
    margin-bottom: 10px

  &__cat
    padding: 2px 8px
    border-radius: 4px
    background-color: var(--accent-soft)
    color: var(--accent)
    font-weight: 500

  &__title
    margin: 0 0 8px
    font-size: 1.06rem
    font-weight: 700
    line-height: 1.45

  &__excerpt
    margin: 0
    font-size: 0.86rem
    color: var(--text-secondary)
    line-height: 1.65

@media (max-width: 768px)
  .insights-grid
    grid-template-columns: 1fr

// E. Personal Philosophy
.philosophy-box
  padding: 36px
  border-radius: var(--radius-lg)
  background-color: var(--surface)
  border: 1px solid var(--border)

  &__quote
    margin: 12px 0 28px
    font-size: 1.32rem
    font-weight: 700
    line-height: 1.55
    letter-spacing: -0.015em
    max-width: 780px

  &__grid
    display: grid
    grid-template-columns: repeat(3, 1fr)
    gap: 24px
    padding-top: 24px
    border-top: 1px solid var(--border)

  &__item
    h3
      margin: 0 0 6px
      font-size: 0.95rem
      font-weight: 700

    p
      margin: 0
      font-size: 0.85rem
      color: var(--text-secondary)

@media (max-width: 768px)
  .philosophy-box
    padding: 24px

    &__quote
      font-size: 1.12rem

    &__grid
      grid-template-columns: 1fr

// F. Speaking & Collaboration Split (Respects 3:4 portrait IMG_0027.JPG)
.speaking-split
  display: grid
  grid-template-columns: 0.72fr 1.28fr
  gap: 36px
  align-items: center
  padding: 28px
  border-radius: var(--radius-lg)
  background-color: var(--surface)
  border: 1px solid var(--border)

  &__img
    display: block
    width: 100%
    aspect-ratio: 3 / 4
    object-fit: cover
    border-radius: var(--radius-md)
    border: 1px solid var(--border)

  &__topics
    margin: 16px 0 22px
    padding-left: 18px
    color: var(--text-secondary)
    font-size: 0.9rem

    li
      margin-bottom: 6px

  &__actions
    display: flex
    flex-wrap: wrap
    gap: 12px

@media (max-width: 768px)
  .speaking-split
    grid-template-columns: 1fr
    padding: 20px

// -----------------------------------------------------------------------------
// Channel Index Pages (Insights / Technology / Thoughts / Projects / Speaking)
// -----------------------------------------------------------------------------
.channel-hero
  padding: 44px 0 28px
  border-bottom: 1px solid var(--border)

  &__title
    margin: 8px 0 10px
    font-size: 2rem
    font-weight: 800
    letter-spacing: -0.025em

  &__desc
    margin: 0
    font-size: 0.96rem
    color: var(--text-secondary)
    max-width: 660px

.filter-bar
  display: flex
  flex-wrap: wrap
  gap: 8px
  margin: 24px 0 28px

.filter-chip
  padding: 5px 14px
  border-radius: 999px
  border: 1px solid var(--border)
  background: var(--surface)
  color: var(--text-secondary)
  font-size: 0.82rem
  font-weight: 500
  cursor: pointer
  transition: all 0.16s ease

  &:hover
    border-color: var(--text-muted)
    color: var(--text)

  &.is-active
    background: var(--accent)
    border-color: var(--accent)
    color: #ffffff

// Article Reading Layout (With Sticky TOC)
.article-wrap
  display: grid
  grid-template-columns: minmax(0, 720px) 220px
  gap: 48px
  padding: 48px 0 72px
  align-items: start

.article-header
  margin-bottom: 32px
  padding-bottom: 24px
  border-bottom: 1px solid var(--border)

  &__title
    margin: 10px 0 12px
    font-size: 1.9rem
    font-weight: 800
    letter-spacing: -0.025em
    line-height: 1.3

  &__meta
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 12px
    font-size: 0.82rem
    color: var(--text-muted)

.toc-aside
  position: sticky
  top: 88px
  padding-left: 16px
  border-left: 1px solid var(--border)
  font-size: 0.8rem

  &__title
    font-weight: 700
    margin-bottom: 10px
    color: var(--text)

  .toc
    list-style: none
    margin: 0
    padding: 0

    ol
      list-style: none
      padding-left: 12px
      margin: 4px 0

    li
      margin-bottom: 5px

    a
      color: var(--text-muted)
      transition: color 0.15s ease

      &:hover
        color: var(--accent)

@media (max-width: 960px)
  .article-wrap
    grid-template-columns: 1fr
  .toc-aside
    display: none

.prose
  color: var(--text-secondary)

  h2
    margin: 36px 0 14px
    font-size: 1.25rem
    font-weight: 700
    color: var(--text)

  h3
    margin: 24px 0 10px
    font-size: 1.05rem
    font-weight: 600
    color: var(--text)

  p
    margin: 0 0 16px

  a
    color: var(--accent)
    text-decoration: underline
    text-underline-offset: 4px

  ul, ol
    margin: 0 0 18px
    padding-left: 20px

    li
      margin-bottom: 6px

  strong
    color: var(--text)

  blockquote
    margin: 20px 0
    padding: 8px 16px
    border-left: 3px solid var(--accent)
    background: var(--accent-soft)
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0

  img
    border-radius: var(--radius-md)
    border: 1px solid var(--border)
    margin: 20px 0
    cursor: zoom-in

  table
    width: 100%
    border-collapse: collapse
    margin: 20px 0
    font-size: 0.875rem

    th, td
      padding: 10px 12px
      border-bottom: 1px solid var(--border)
      text-align: left

  code
    padding: 2px 6px
    border-radius: 4px
    background: var(--surface-alt)
    font-size: 0.85em

  figure.highlight
    margin: 20px 0
    border-radius: var(--radius-md)
    background: var(--surface-alt)
    border: 1px solid var(--border)
    overflow-x: auto

    table
      margin: 0

    td
      border: none
      padding: 12px 14px

    td.gutter
      width: 1%
      opacity: 0.5
      user-select: none

    pre
      margin: 0
      font-size: 0.84rem

.related-posts
  margin-top: 48px
  padding-top: 28px
  border-top: 1px solid var(--border)

  &__title
    margin: 0 0 16px
    font-size: 1rem
    font-weight: 700

  &__list
    display: grid
    grid-template-columns: repeat(2, 1fr)
    gap: 14px

  &__item
    padding: 14px 16px
    border-radius: var(--radius-sm)
    background: var(--surface)
    border: 1px solid var(--border)
    font-size: 0.88rem
    font-weight: 500

    &:hover
      border-color: var(--accent)

@media (max-width: 640px)
  .related-posts__list
    grid-template-columns: 1fr

// -----------------------------------------------------------------------------
// Footer, Search Modal, Lightbox, Toast & Subtle Reveal
// -----------------------------------------------------------------------------
.site-footer
  border-top: 1px solid var(--border)
  padding: 48px 0 36px
  background-color: var(--surface)

  &__grid
    display: grid
    grid-template-columns: 1.5fr 1fr
    gap: 40px

  &__name
    margin: 0
    font-size: 1rem
    font-weight: 700

  &__tagline
    margin: 8px 0 16px
    font-size: 0.86rem
    color: var(--text-secondary)
    max-width: 420px

  &__contact
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 12px
    font-size: 0.82rem

    a
      color: var(--accent)

  &__nav
    display: grid
    grid-template-columns: repeat(2, 1fr)
    gap: 20px

    h4
      margin: 0 0 10px
      font-size: 0.82rem
      color: var(--text)

    a
      display: block
      margin-bottom: 6px
      font-size: 0.84rem
      color: var(--text-muted)

      &:hover
        color: var(--text)

  &__bottom
    margin-top: 32px
    padding-top: 20px
    border-top: 1px solid var(--border)
    display: flex
    justify-content: space-between
    font-size: 0.78rem
    color: var(--text-muted)

@media (max-width: 768px)
  .site-footer__grid
    grid-template-columns: 1fr

.copy-btn
  padding: 5px 12px
  border-radius: var(--radius-sm)
  border: 1px solid var(--border)
  background: var(--surface-alt)
  color: var(--text)
  font-size: 0.8rem
  cursor: pointer

  &:hover
    border-color: var(--accent)

.search-modal
  position: fixed
  inset: 0
  z-index: 70
  display: none
  align-items: flex-start
  justify-content: center
  padding: 80px 16px 24px

  &.is-open
    display: flex

  &__backdrop
    position: absolute
    inset: 0
    background: rgba(0, 0, 0, 0.5)

  &__dialog
    position: relative
    width: 100%
    max-width: 580px
    border-radius: var(--radius-md)
    background: var(--surface)
    border: 1px solid var(--border)
    box-shadow: var(--shadow-md)
    overflow: hidden

  &__input-wrap
    display: flex
    align-items: center
    padding: 12px 16px
    border-bottom: 1px solid var(--border)

  &__input
    flex: 1
    border: none
